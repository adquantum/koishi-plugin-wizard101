{
  "name": "koishi-plugin-wizard101",
  "version": "0.3.1",
  "description": "Kimerith 中文版 Koishi 插件：完整查询命令、法术效果树、战斗计算、QQ 官方 Bot / Discord 原生交互",
  "main": "lib/index.cjs",
  "types": "lib/index.d.ts",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib",
    "assets/icons",
    "tools/**/*.cjs",
    "tools/**/*.py",
    "tools/**/README.md",
    "test/*.test.cjs",
    "test/*.py",
    "examples",
    "docs",
    "data/README.md",
    "data/locale-example.json",
    "data/catalog-example.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "CONTRIBUTING.md",
    "LICENSES"
  ],
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "import:locale": "node tools/locale/import.cjs",
    "probe": "node tools/probe-api.cjs",
    "check": "node tools/check-syntax.cjs",
    "check:public": "node tools/check-public-package.cjs",
    "prepack": "node tools/check-public-package.cjs",
    "import:icons": "python tools/icons/import.py",
    "import:catalog": "python tools/catalog/from-sqlite.py"
  },
  "peerDependencies": {
    "koishi": "^4.18.11"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "opencc-js": "1.4.2"
  },
  "devDependencies": {
    "@koishijs/plugin-mock": "2.6.6",
    "@satorijs/adapter-discord": "4.6.2",
    "@satorijs/adapter-qq": "4.14.0",
    "koishi": "4.18.11"
  },
  "keywords": [
    "koishi",
    "plugin",
    "wizard101",
    "wizard404",
    "wiki",
    "chinese",
    "qq",
    "discord",
    "cards"
  ],
  "koishi": {
    "description": {
      "zh": "Wizard101 中文图鉴；QQ 官方 Bot/Discord 图卡、本地资料、Wiki 查询与伤害估算。"
    }
  },
  "homepage": "https://github.com/adquantum/koishi-plugin-wizard101#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adquantum/koishi-plugin-wizard101.git"
  },
  "bugs": {
    "url": "https://github.com/adquantum/koishi-plugin-wizard101/issues"
  }
}
